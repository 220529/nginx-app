# One managed reverse-proxy site. Add another file here for another project.

SITE_NAME=erp-settlement
SITE_DOMAIN=erp.lytt.fun
SITE_CONFIG_FILE=erp-settlement.conf
SITE_UPSTREAM_URL=http://127.0.0.1:8080
SITE_TLS_ENABLED=true
SITE_CERTBOT_ENABLED=true
SITE_HEALTH_PATH=/login
SITE_API_HEALTH_PATH=/api/health
SITE_HEALTH_CHECK_REQUIRED=true
