# Non-secret settings for the shared host Nginx gateway.
# Project-specific values belong in config/sites/*.env.

GATEWAY_TAG_PREFIX=master/nginx-app
GATEWAY_STAGING_DIR=/tmp/nginx-gateway
GATEWAY_CONFIG_DIR=/etc/nginx/conf.d
GATEWAY_MANIFEST_PATH=/etc/nginx/conf.d/.nginx-gateway-managed
GATEWAY_BACKUP_DIR=/var/lib/nginx-gateway/previous
GATEWAY_SECRET_DIR=/etc/nginx/gateway-secrets
GATEWAY_WEBROOT_PATH=/var/www/nginx-gateway/acme
GATEWAY_CERTBOT_TIMER_NAME=nginx-gateway-certbot-renew
GATEWAY_RENEW_ON_CALENDAR='*-*-* 03:17:00'
GATEWAY_RENEW_RANDOM_DELAY=30m
