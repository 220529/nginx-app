# Non-secret deployment settings shared by the renderer, Tag helper and
# manual server scripts. Credentials stay in GitHub Actions Secrets.

NGINX_DOMAIN=erp.lytt.fun
NGINX_UPSTREAM_HOST=127.0.0.1
NGINX_UPSTREAM_PORT=8080
NGINX_CONFIG_PATH=/etc/nginx/conf.d/erp-settlement.conf
NGINX_STAGING_DIR=/tmp/erp-settlement-nginx
NGINX_WEBROOT_PATH=/var/www/certbot
NGINX_TAG_PREFIX=master/nginx-app
NGINX_TIMER_NAME=erp-settlement-certbot-renew
NGINX_RENEW_ON_CALENDAR='*-*-* 03:17:00'
NGINX_RENEW_RANDOM_DELAY=30m
NGINX_HEALTH_PATH=/login
NGINX_API_HEALTH_PATH=/api/health
NGINX_HEALTH_CHECK_REQUIRED=true
